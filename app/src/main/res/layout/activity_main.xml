<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:color="@color/white">

    <ImageView
        android:id="@+id/my_image_view"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/logo_png"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"/>

    <TextView
        android:id="@+id/welcome_text"
        android:fontFamily="sans-serif-smallcaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Magix!"
        android:textSize="24sp"
        android:layout_below="@id/my_image_view"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"/>

    <TextView
        android:id="@+id/instructions_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="To select a function, click on the corresponding button.\nFor further information on each function, check the descriptions provided at the information button."
        android:layout_below="@id/welcome_text"
        android:layout_centerHorizontal="true"
        android:padding="16dp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/title_sub_text"
        android:fontFamily="sans-serif-smallcaps"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/instructions_text"
        android:text="Functions"
        android:textSize="24sp"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:layout_centerHorizontal="true"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_below="@id/title_sub_text"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_think_of_a_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Think of a Card"/>

            <Button
                android:id="@+id/btn_info_think_of_a_card"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_info"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_coin_through_phone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Coin Through Phone"/>

            <Button
                android:id="@+id/btn_info_coin_through_phone"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_info"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_mental_calc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mental Calc"/>

            <Button
                android:id="@+id/btn_info_mental_calc"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_info"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_mind_reading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Mind Reading"/>

            <Button
                android:id="@+id/btn_info_mind_reading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/ic_info"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <Button
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</RelativeLayout>
