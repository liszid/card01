<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#000000">

    <TextView
        android:id="@+id/resultView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="130dp"
        android:layout_marginBottom="16dp"
        android:background="#000000"
        android:ellipsize="start"
        android:gravity="end"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:text="@string/calc_0"
        android:textColor="#ffffff"
        android:textSize="48sp"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <GridLayout
        android:id="@+id/buttonGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/resultView"
        android:layout_marginTop="25dp"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:padding="16dp"
        android:useDefaultMargins="true">
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAC"
            style="@style/CalcButtonStyleLight"
            android:text="@string/calc_ac" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSign"
            style="@style/CalcButtonStyleLight"
            android:text="@string/calc_plus_minus" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnPercent"
            style="@style/CalcButtonStyleLight"
            android:text="@string/calc_percent" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDivide"
            style="@style/CalcButtonStyleOrange"
            android:text="@string/calc_divide" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn7"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_7" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn8"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_8" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn9"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_9" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMultiply"
            style="@style/CalcButtonStyleOrange"
            android:text="@string/calc_multiple" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn4"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_4" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn5"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_5" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn6"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_6" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSubtract"
            style="@style/CalcButtonStyleOrange"
            android:text="@string/calc_minus" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn1"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_1" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn2"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_2" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn3"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_3" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnAdd"
            style="@style/CalcButtonStyleOrange"
            android:text="@string/calc_plus" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn0"
            style="@style/CalcButtonStyleDark"
            android:layout_columnSpan="2"
            android:text="@string/calc_0" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnDot"
            style="@style/CalcButtonStyleDark"
            android:text="@string/calc_dot" />
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnEquals"
            style="@style/CalcButtonStyleOrange"
            android:text="@string/calc_equal" />
    </GridLayout>
</RelativeLayout>
