<resources>
    <style name="CalcButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">75dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">24sp</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_margin">4dp</item>
    </style>

    <style name="CalcButtonStyleLight" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_background_light</item>
        <item name="android:textColor">#000000</item>
    </style>

    <style name="CalcButtonStyleDark" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_background_dark</item>
        <item name="android:textColor">#ffffff</item>
    </style>

    <style name="CalcButtonStyleOrange" parent="CalcButtonStyle">
        <item name="android:background">@drawable/button_background_orange</item>
        <item name="android:textColor">#ffffff</item>
    </style>
</resources>
